{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Run (CLI)",
      "type": "debugpy",
      "request": "launch",
      "module": "geo_builder.cli",
      "args": ["${workspaceFolder}/template.json", "--in", "${workspaceFolder}/in", "--out", "${workspaceFolder}/out"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: Run (Designer)",
      "type": "debugpy",
      "request": "launch",
      "module": "geo_builder.cli",
      "args": [
        "${workspaceFolder}/template.json", 
        "--in", "${workspaceFolder}/in", 
        "--out", "${workspaceFolder}/out", 
        "--edit"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: Run PyTest",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v", "-s", "-x"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Python: Debug pytest (scratch)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-s", 
        "--log-cli-level=INFO", 
        "tests/scratch/test_scratch.py::test_scratch"
      ],
      "console": "internalConsole",
      "justMyCode": true
    },
  ],
  "inputs": [
  ]
}
